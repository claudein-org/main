# Image for the analytics-sync DigitalOcean job.
#
# The main /Dockerfile ships a Next.js *standalone* build, which only bundles the
# files Next traces from the server entry — it does NOT contain web/jobs/sync.ts.
# This image instead carries the full repo source + workspace deps so the job can
# run the script directly with bun.
FROM oven/bun:latest

WORKDIR /app

COPY package.json bun.lock ./
COPY common/package.json ./common/
COPY web/package.json ./web/
COPY cli/package.json ./cli/
COPY video/package.json ./video/

RUN bun install --frozen-lockfile

COPY . .

# Resolves @/* via web/tsconfig.json and @claudein.org/common via the workspace.
CMD ["bun", "web/jobs/sync.ts"]
